generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              String   @id @default(cuid())
  nome            String
  cpf             String   @unique
  email           String   @unique
  senha           String
  cargo           String
  estabelecimento String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("usuarios")
}